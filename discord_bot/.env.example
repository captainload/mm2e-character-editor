# ================================================================
# Mutants & Masterminds 2E VTT - Discord Relay Bot Configuration
# ================================================================

# 1. Discord Bot Token (REQUIRED)
# Obtain this from https://discord.com/developers/applications
# Create an Application -> Bot tab -> Reset Token -> Paste below:
DISCORD_TOKEN=your_bot_token_here

# 2. Discord Channel ID(s) (REQUIRED)
# In Discord Settings -> Advanced -> Enable Developer Mode.
# Right-click your desired channel (e.g. #vtt-session) -> "Copy Channel ID":
CHANNEL_ID=your_channel_id_here

# (Optional) Dedicated separate channels for rolls and chat:
# If left empty, CHANNEL_ID above is used for both.
ROLLS_CHANNEL_ID=
CHAT_CHANNEL_ID=

# 3. Local HTTP/WebSocket Bridge Port (default: 18820)
# This port allows the Mutants & Masterminds Hero Builder to connect to the bot locally.
BRIDGE_PORT=18820

# 4. Campaign Code Filter (Optional)
# If set, only events matching this campaign code (e.g. campaign-1) will be relayed.
# Leave blank to relay all local campaigns.
CAMPAIGN_CODE=

# 5. Command Prefix (default: !mm )
# Commands in Discord start with this prefix (e.g., !mm roll 1d20+8, !mm status)
PREFIX=!mm 

# 6. Listen in All Channels (default: false)
# When false, the bot only responds in the configured CHANNEL_ID(s).
ALLOW_ALL_CHANNELS=false
